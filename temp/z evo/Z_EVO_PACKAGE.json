{
  "name": "z-evo",
  "version": "1.0.0",
  "description": "Z-Evo AI Agent System - Professional AI Development Platform",
  "main": "launch.sh",
  "scripts": {
    "start": "./launch.sh start",
    "stop": "./launch.sh stop",
    "status": "./launch.sh status",
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:frontend\"",
    "dev:api": "cd project/api-gateway && python3 main.py",
    "dev:frontend": "cd project/frontend && npm start",
    "build": "cd project/frontend && npm run build",
    "test": "jest",
    "setup": "npm install && cd project/frontend && npm install"
  },
  "keywords": [
    "ai",
    "agent",
    "llm",
    "development",
    "platform"
  ],
  "author": "Sahon Srabon",
  "license": "MIT",
  "dependencies": {
    "concurrently": "^8.0.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  }
}