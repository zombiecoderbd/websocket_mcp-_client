{
  "name": "direct-editor-integration",
  "displayName": "Direct Editor Integration",
  "description": "Direct integration with Agent-Editor Bridge for real-time AI assistance",
  "version": "1.0.0",
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./vscode-direct-integration.js",
  "contributes": {
    "commands": [
      {
        "command": "directEditor.connect",
        "title": "Direct Editor: Connect to Bridge"
      },
      {
        "command": "directEditor.disconnect",
        "title": "Direct Editor: Disconnect from Bridge"
      },
      {
        "command": "directEditor.status",
        "title": "Direct Editor: Show Status"
      },
      {
        "command": "directEditor.sendTest",
        "title": "Direct Editor: Send Test Message"
      }
    ],
    "configuration": {
      "title": "Direct Editor Integration",
      "properties": {
        "directEditor.autoConnect": {
          "type": "boolean",
          "default": true,
          "description": "Automatically connect to Agent-Editor Bridge on startup"
        },
        "directEditor.bridgeUrl": {
          "type": "string",
          "default": "ws://localhost:8081",
          "description": "WebSocket URL for Agent-Editor Bridge"
        },
        "directEditor.enableRealtimeSync": {
          "type": "boolean",
          "default": true,
          "description": "Enable real-time synchronization with agents"
        }
      }
    }
  },
  "scripts": {
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/node": "^16.0.0",
    "@types/vscode": "^1.60.0",
    "vsce": "^2.15.0"
  },
  "dependencies": {
    "ws": "^8.0.0"
  }
}